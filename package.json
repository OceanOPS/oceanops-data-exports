{
  "name": "oceanops-data-exports",
  "private": true,
  "version": "1.0.0",
  "description": "OceanOPS Report / globe static data exports (partner counts, GeoJSON layers)",
  "type": "module",
  "scripts": {
    "export:partners": "node export-partner-countries.mjs",
    "export:partners:dry-run": "node export-partner-countries.mjs --dry-run",
    "export:geojson": "node export-geojson.mjs",
    "export:geojson:dry-run": "node export-geojson.mjs --dry-run",
    "export:observations": "node export-observations-per-day.mjs",
    "export:observations:dry-run": "node export-observations-per-day.mjs --dry-run",
    "export:observations:compare": "node export-observations-per-day.mjs --compare-obs-filters",
    "export:observations:compare:dry-run": "node export-observations-per-day.mjs --compare-obs-filters --dry-run",
    "export:observations:compare-2025": "node export-observations-per-day.mjs --compare-obs-filters --year 2025",
    "export:observations:compare-2026": "node export-observations-per-day.mjs --compare-obs-filters --year 2026",
    "export:gts-network-obs": "node export-gts-network-obs.mjs",
